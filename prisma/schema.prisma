// نظام إدارة حلقات تحفيظ القرآن الكريم
// schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ المستخدمون والأدوار ============

enum Role {
  DEVELOPER // المطورة - صلاحيات كاملة فوق المديرة
  ADMIN // المديرة
  SUPERVISOR // المشرفة
  TEACHER // المعلمة
}

enum UserStatus {
  PENDING // بانتظار موافقة المديرة
  ACTIVE // مفعّل
  REJECTED // مرفوض
  SUSPENDED // موقوف
}

model User {
  id                  String     @id @default(cuid())
  name                String
  nationalIdHash      String     @unique // بصمة SHA-256 لرقم الهوية/الإقامة (للتحقق من التكرار وتسجيل الدخول)
  nationalIdEncrypted String // رقم الهوية/الإقامة مشفّر (AES-256-GCM) - تراه المديرة فقط
  nationalIdLastFour  String // آخر 4 أرقام تُعرض بدون فك تشفير
  passwordHash        String
  role                Role
  status              UserStatus @default(PENDING)
  phone               String?
  avatarUrl           String? // صورة الحساب (اختيارية) - تُخزَّن كـ data URL مصغّرة
  lastSeenAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // حماية تسجيل الدخول من محاولات التخمين المتكررة
  failedLoginAttempts Int       @default(0) // عدد محاولات الدخول الفاشلة المتتالية
  lockedUntil         DateTime? // إن كان في المستقبل، الحساب موقوف مؤقتًا عن الدخول

  // بيانات إضافية خاصة بالمعلمة/المشرفة (مطلوبة عند الإضافة/التعديل) - تُستخدم في صفحة تفاصيل الحلقة
  nationality     String? // الجنسية
  age             Int? // العمر
  educationLevel  String? // المؤهل الدراسي
  residence       String? // مقر الإقامة
  memorizedAmount String? // مقدار حفظها من القرآن الكريم
  experience      String? // الخبرة

  teacherHalaqa     Halaqa?   @relation("TeacherHalaqa")
  sessions          Session[]

  staffAttendance StaffAttendance[] @relation("StaffAttendanceUser")
  leaveRequests   LeaveRequest[]    @relation("LeaveRequester")

  // مشرفة المسار: حساب دخول كامل مرتبط بمسار واحد (بدون @unique للسماح بعدة مشرفات لنفس المسار)
  supervisedTrackId String?
  supervisedTrack   Track?  @relation("TrackSupervisors", fields: [supervisedTrackId], references: [id])

  @@index([role, status])
  @@index([supervisedTrackId])
}

model Session {
  id           String    @id @default(cuid())
  token        String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String? // متصفح/جهاز المستخدم وقت إنشاء الجلسة
  ipAddress    String? // عنوان IP وقت إنشاء الجلسة
  lastActiveAt DateTime? // آخر طلب استخدم هذه الجلسة - لعرضها في "الجلسات النشطة"
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// ============ المسارات ============
// تجميع الحلقات ضمن مسارات كبرى (مثال: مسار الجمان، مسار الرواء، مسار رواس)

model Track {
  id        String   @id @default(cuid())
  name      String   @unique
  imageUrl  String? // صورة المسار (اختيارية) - تُخزَّن كـ data URL مصغّرة
  createdAt DateTime @default(now())

  halaqat     Halaqa[]
  supervisors User[]   @relation("TrackSupervisors")
}

// ============ البرامج (سجل الإنجازات) ============
// سجل مستقل بالبرامج التي تنفذها المقرأة (منفصل عن الحلقات والطالبات)

model Program {
  id             String   @id @default(cuid())
  name           String
  description    String? // وصف البرنامج
  duration       String // مدة البرنامج (نص حر، مثل: 3 أشهر)
  academicYear   String // العام الدراسي، مثال: 1447هـ
  reportUrl      String? // ملف التقرير الختامي (PDF أو صورة) - يُخزَّن كـ data URL
  reportFileName String? // اسم الملف الأصلي، لعرضه عند التحميل
  coverImageUrl  String? // صورة تعريفية للبرنامج (اختيارية) - تُخزَّن كـ data URL مصغّرة
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============ الحلقات ============

enum HalaqaCategory {
  MOTHERS // أمهات
  GIRLS // فتيات
  CHILDREN // أطفال
}

model Halaqa {
  id           String          @id @default(cuid())
  name         String
  time         String // وقت الحلقة (نص حر، مثل: بعد صلاة العصر)
  category     HalaqaCategory? // تصنيف الحلقة: أمهات/فتيات/أطفال
  isActive     Boolean         @default(true)
  teacherId    String?         @unique
  teacher      User?           @relation("TeacherHalaqa", fields: [teacherId], references: [id])
  supervisorName String? // اسم مشرفة الحلقة (نص حر، بدون حساب دخول)
  days           String[]      @default([]) // أيام انعقاد الحلقة: SUN/MON/TUE/WED/THU/FRI/SAT
  order        Int             @default(0) // ترتيب العرض اليدوي، تُحرَّكه المديرة/المشرفة بالأسهم في صفحة الحلقات
  trackId      String?
  track        Track?          @relation(fields: [trackId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  students       Student[]
  attendanceLogs AttendanceLog[]

  @@index([trackId])
}

// ============ الطالبات ============

model Student {
  id                  String   @id @default(cuid())
  name                String
  nationality         String
  halaqaId            String
  halaqa              Halaqa   @relation(fields: [halaqaId], references: [id])
  nationalIdEncrypted String? // رقم هوية الطالبة مشفّر (AES-256-GCM) - تراه المديرة/المشرفة فقط
  nationalIdLastFour  String? // آخر 4 أرقام تُعرض بدون فك تشفير
  age                 Int? // العمر
  educationLevel      String? // المؤهل الدراسي
  residence           String? // مقر الإقامة
  memorizedAmount     String? // مقدار الحفظ من القرآن الكريم (وصف عام عند التسجيل)
  memorizedPagesTotal Int      @default(0) // إجمالي عدد الأوجه المحفوظة
  currentQuota        String? // نصاب الحفظ الحالي
  notes               String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memorizationRecords MemorizationRecord[]
  examGrades          ExamGrade[]
  attendanceRecords   StudentAttendance[]

  @@index([halaqaId])
}

// سجل يومي لتقدم الحفظ (يُبنى منه الأرشيف والشهادات)
model MemorizationRecord {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  date           DateTime
  pagesMemorized Int // عدد الأوجه المحفوظة في هذا التسجيل
  quota          String? // النصاب المحدد لهذا اليوم
  enteredById    String // المعلمة التي أدخلت البيانات
  createdAt      DateTime @default(now())

  @@index([studentId, date])
}

// درجات الاختبارات (تُستخدم للأرشفة والشهادات)
model ExamGrade {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  quota       String // النصاب المختبر فيه
  grade       Float
  maxGrade    Float    @default(100)
  examDate    DateTime
  enteredById String
  createdAt   DateTime @default(now())

  @@index([studentId])
}

// سجل حضور الحلقة اليومي (يُستخدم لتنبيهات عدم التسجيل ولوحة الشرف)
model AttendanceLog {
  id             String    @id @default(cuid())
  halaqaId       String
  halaqa         Halaqa    @relation(fields: [halaqaId], references: [id])
  date           DateTime
  teacherPresent Boolean   @default(true)
  dataSubmitted  Boolean   @default(false)
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())

  studentAttendance StudentAttendance[]

  @@unique([halaqaId, date])
  @@index([date])
}

model StudentAttendance {
  id              String        @id @default(cuid())
  attendanceLogId String
  attendanceLog   AttendanceLog @relation(fields: [attendanceLogId], references: [id])
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id])
  present         Boolean       @default(true)

  @@unique([attendanceLogId, studentId])
}

// ============ حضور وإجازات الطاقم (المعلمات/المشرفات) ============

enum StaffAttendanceStatus {
  PRESENT // حاضرة
  ABSENT // غائبة
  LEAVE // إجازة (تُضبط تلقائيًا عند قبول طلب إجازة)
}

model StaffAttendance {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation("StaffAttendanceUser", fields: [userId], references: [id])
  date         DateTime
  status       StaffAttendanceStatus @default(PRESENT)
  note         String?
  recordedById String // من سجّلت هذا اليوم (المستخدمة نفسها أو من وافقت على الإجازة)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

enum LeaveRequestStatus {
  PENDING // بانتظار المراجعة
  APPROVED // مقبولة
  REJECTED // مرفوضة
}

model LeaveRequest {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation("LeaveRequester", fields: [userId], references: [id])
  fromDate       DateTime
  toDate         DateTime
  reason         String
  status         LeaveRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime           @default(now())

  @@index([userId])
  @@index([status])
}

// ============ إعدادات الموقع العامة (صف وحيد) ============
// تُستخدم حاليًا لتخزين شعار الموقع القابل للتعديل من لوحة الإعدادات

model AppSettings {
  id        String   @id @default("main")
  logoUrl   String? // شعار الموقع (اختياري) - يُخزَّن كـ data URL، وإلا يُعرض الشعار الافتراضي
  updatedAt DateTime @updatedAt
}

// ============ سجل الحركات (Audit Log) ============
// يسجّل كل عملية إضافة/تعديل/حذف يقوم بها المستخدمون لمراجعتها من قبل المديرة

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  actorRole   Role
  action      String // مفتاح العملية، مثال: STUDENT_UPDATE
  targetType  String // نوع الهدف، مثال: Student, Halaqa, User
  targetId    String?
  targetLabel String // اسم مقروء للهدف، مثال: اسم الطالبة
  message     String // وصف العملية بصيغة عربية، مثال: "عدّلت بيانات الطالبة"
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

// ============ قوالب الشهادات ============
// خلفية شهادة مخصصة قابلة للرفع كل ترم، مع مواضع نصوص/صور قابلة للتخصيص
// (إحداثيات بكسل مباشرة على كانفاس ثابت 3508×2480 - راجع src/lib/certificateRender.ts)

model CertificateTemplate {
  id            String   @id @default(cuid())
  name          String
  backgroundUrl String // data URL لصورة خلفية الشهادة
  layout        Json // مواضع كل عنصر نصي/صورة على الكانفاس
  isActive      Boolean  @default(false)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
}
